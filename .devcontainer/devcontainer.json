// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://containers.dev/implementors/json_reference/
{
    "name": "transplat devcontainer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "shutdownAction": "none",
    "runArgs": ["--gpus=all", "--ipc=host"],
    // uv runs at container runtime, so its cache and managed Pythons live in named volumes that survive container rebuilds.
    // Volumes are keyed by the host user so users with different UIDs on a shared Docker daemon don't collide; the cache is shared across that user's devcontainers.
    "mounts": [
        "source=uv-cache-${localEnv:USER},target=/home/vscode/.cache/uv,type=volume",
        "source=transplat-uv-data-${localEnv:USER},target=/home/vscode/.local/share/uv,type=volume",
        // zellij web login tokens (tokens.db) survive container rebuilds.
        "source=transplat-zellij-data-${localEnv:USER},target=/home/vscode/.local/share/zellij,type=volume",
        // Share Claude Code session history and memory with the host; the source directory must exist on the host.
        "source=${localEnv:HOME}/.config/claude/projects,target=/home/vscode/.config/claude/projects,type=bind"
    ],
    "containerEnv": {
        "UV_LINK_MODE": "copy"
    },
    "remoteUser": "vscode",
    // -n keeps files Claude Code has already rewritten at runtime (e.g. .claude.json) instead of resetting them.
    "postCreateCommand": "git config --global --add safe.directory '*' && git config core.fileMode false && cp -rn .devcontainer/claude-config/. \"$CLAUDE_CONFIG_DIR\"/",
    // The zellij web client binds to the container's loopback only; the forwarded port exposes it on the host's localhost.
    "postStartCommand": "zellij web --daemonize",
    "forwardPorts": [8082],
    "portsAttributes": {
        "8082": {
            "label": "zellij web",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "waderyan.gitblame",
                "jnoortheen.nix-ide",
                "FanaticPythoner.better-todo-tree",
                "bierner.github-markdown-preview",
                "ms-python.python",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
                "python.terminal.activateEnvironment": false
            }
        }
    }
}
