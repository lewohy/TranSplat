// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://containers.dev/implementors/json_reference/
{
    "name": "transplat devcontainer",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "runArgs": ["--gpus=all", "--ipc=host"],
    // uv runs at container runtime, so its cache and managed Pythons live in named volumes that survive container rebuilds.
    // Volumes are keyed by the host user so users with different UIDs on a shared Docker daemon don't collide; the cache is shared across that user's devcontainers.
    "mounts": [
        "source=uv-cache-${localEnv:USER},target=/home/vscode/.cache/uv,type=volume",
        "source=transplat-uv-data-${localEnv:USER},target=/home/vscode/.local/share/uv,type=volume"
    ],
    "containerEnv": {
        "UV_LINK_MODE": "copy"
    },
    "remoteUser": "vscode",
    "postCreateCommand": "git config --global --add safe.directory '*' && git config core.fileMode false",
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "waderyan.gitblame",
                "jnoortheen.nix-ide",
                "FanaticPythoner.better-todo-tree",
                "bierner.github-markdown-preview",
                "ms-python.python",
                "charliermarsh.ruff",
                "tamasfe.even-better-toml",
                "ms-python.vscode-pylance"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
                "python.terminal.activateEnvironment": false
            }
        }
    }
}
